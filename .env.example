# =============================================================
# CardScan AI - Environment Configuration Template
# =============================================================

# GEMINI_API_KEY: Required for Gemini AI visiting card entity extraction.
# Automatically injected by Google AI Studio at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosting domain URL for API communication and callbacks.
# Automatically injected by AI Studio at runtime with the Cloud Run service URL.
APP_URL="https://ais-pre-vqx2otwrsspxphopzt6q2u-463262227538.asia-southeast1.run.app"

# Server Port (Development runs on port 3000)
PORT=3000

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardscan_db"

# JWT Authentication Secrets
JWT_SECRET="cardscan_jwt_secret_production_key_2026"
JWT_REFRESH_SECRET="cardscan_jwt_refresh_secret_production_key_2026"

# OCR & AI Providers
OCR_PROVIDER="google_ml_kit"
AI_PROVIDER="gemini-3.8-flash"

# Local File Storage (Saved inside local project directory)
STORAGE_TYPE="local"
STORAGE_LOCAL_DIR="./uploads/cards"

# External Lead API Integration
# Local testing defaults to http://localhost:3005. Keep the API key server-side only.
LEAD_API_BASE_URL="http://localhost:3005"
LEAD_API_KEY=""
LEAD_API_TIMEOUT_MS=10000
